name: cidades-esg-inteligentes
services:
  api:
    build:
      context: C:\Users\Fernanda Mazala\Documents\Codex\2026-10-12\voc\work\sus-devops
      dockerfile: Dockerfile
    depends_on:
      sqlserver:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:8080
      AppUser__Password: admin123
      AppUser__Username: admin
      ConnectionStrings__DefaultConnection: Server=sqlserver,1433;Database=SusDb;User
        Id=sa;Password=Sus@123456;TrustServerCertificate=True
      Jwt__Audience: Sus.Api
      Jwt__Issuer: Sus.Api
      Jwt__Secret: segredo-super-seguro-para-sus-api-dotnet-8
    networks:
      sus_network: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
  sqlserver:
    environment:
      ACCEPT_EULA: 'Y'
      SA_PASSWORD: Sus@123456
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      sus_network: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    volumes:
      - type: volume
        source: sus_sqlserver
        target: /var/opt/mssql
        volume: {}
networks:
  sus_network:
    name: cidades-esg-inteligentes_sus_network
    driver: bridge
volumes:
  sus_sqlserver:
    name: cidades-esg-inteligentes_sus_sqlserver
